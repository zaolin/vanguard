# /etc/vanguard/vanguard.env
# Configuration for vanguard-pcrlock-relock.service
#
# This service automatically re-locks the vanguard pcrlock policy and
# re-provisions the TOTP recovery seed after a firmware update that
# changes Secure Boot keys (PCR 7).
#
# Copy this file to /etc/vanguard/vanguard.env and adjust the paths:
#   sudo cp /etc/vanguard/vanguard.env.example /etc/vanguard/vanguard.env
#   sudo systemctl enable vanguard-pcrlock-relock.service
#
# After the service runs post-firmware-update, retrieve the new TOTP seed:
#   sudo vanguard recovery --show

UKI_PATH=/boot/EFI/Gentoo/kernel.efi
LUKS_DEVICE=/dev/nvme0n1p2